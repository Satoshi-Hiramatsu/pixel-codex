<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PCの接続設定QRを読み取るためだけに使います。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      usesCleartextTraffic：同じWi-Fi内のPCへはIPアドレスで直接つなぐため、暗号化なしの
      通信が要ります（ペアリングのhttp://、Relayのws://、画面プレビューの取得）。宛先を
      プライベートIP帯だけに絞る判断は RemoteClient.connect が行います。ネットワーク設定
      XMLではIPの範囲を書けないため、制限はアプリ側のコードで持たせています。
    -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/pixel_codex_app_icon"
        android:label="Pixel Codex"
        android:roundIcon="@drawable/pixel_codex_app_icon"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
